COMPOSE_PROJECT_NAME=remotellm
TZ=Europe/Athens
PUID=1000
PGID=1000

# Nginx bind address. Default is localhost-only. Set to 0.0.0.0 for LAN access.
# WARNING: LAN access exposes the browser IDE and terminal to your network.
# Ensure authentication (CODE_SERVER_PASSWORD, TTYD_PASSWORD) is changed from defaults.
NGINX_BIND=127.0.0.1
NGINX_PORT=8088
# Base path for nested deployment behind another nginx (e.g. /remotellm). Leave empty for root deployment.
BASE_PATH=

# WireGuard config is expected at volumes/wireguard/wg_confs/wg0.conf after `make init`.
WIREGUARD_IMAGE=lscr.io/linuxserver/wireguard:1.0.20250521-r1-ls113

# =============================================================================
# Ollama (optional)
# =============================================================================
# RemoteLLM does not require Ollama. Leave this section as-is and agents still
# work through Anthropic (ANTHROPIC_API_KEY further below) or the CPU-only
# BitNet profile (`make up-cpu-llm`). The `ollama-default` and `hermes` LiteLLM
# aliases simply error at call time until this is configured — nothing else in
# the stack depends on them.
#
# Two ways to reach a real Ollama instance:
#   1. Directly reachable (same LAN, no VPN needed): point OLLAMA_BASE_URL at
#      it and leave the VPN off.
#   2. Privately hosted behind your own WireGuard server: run `make up-vpn`,
#      set OLLAMA_FORWARD_TARGET below to Ollama's address as seen from inside
#      that VPN, and set OLLAMA_BASE_URL=http://wireguard:11434.
# See docs/guides/wireguard.md for notes on running your own WireGuard server
# (only client mode is supported today; more VPN options are planned).
OLLAMA_BASE_URL=http://ollama.example.internal:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_PROXY=socks5h://wireguard:1080
# vpn-proxy forwards wireguard:11434 to this address (only used with `make up-vpn`).
# Must be reachable from inside your WireGuard server's network.
OLLAMA_FORWARD_TARGET=10.5.5.5:11434
OLLAMA_FORWARD_PORT=11434

# Agent path: agent -> LiteLLM on Docker network -> configured Ollama endpoint.
# Do not set ALL_PROXY/HTTP_PROXY/HTTPS_PROXY in the agent; package managers and Bun do not need the VPN.
LOCAL_ENDPOINT=http://litellm:4000/v1
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=change-me
# Internal runtime metadata. Services override AGENT_PROFILE; AGENT_MODEL_ALIAS is a
# default hint for wrappers/docs until model routing becomes profile-aware.
AGENT_PROFILE=agent
AGENT_MODEL_ALIAS=ollama-default
NO_PROXY=localhost,127.0.0.1,agent,nginx,code-server,litellm,wireguard

# Browser tools.
CODE_SERVER_PASSWORD=change-me
TTYD_USER=agent
TTYD_PASSWORD=change-me
# Password for the 'dev' user inside the agent container (UID 1001, password-required sudo).
# To switch from passwordless agent to restricted dev: set user: "1001:1000" in compose.yml.
DEV_PASSWORD=change-me
# OpenCode web UI port (only used with the opencode-web profile).
OPENCODE_WEB_PORT=4040
# Password for the opencode web UI (HTTP basic auth, username: opencode).
OPENCODE_SERVER_PASSWORD=change-me
# Hermes dashboard port (only used with the hermes-web profile).
HERMES_WEB_PORT=8645

# Hermes dashboard basic-auth credentials (nginx gate, used when NGINX_BIND=0.0.0.0).
# Run `make init` after changing these to regenerate .local/volumes/nginx-auth/hermes.htpasswd.
HERMES_DASHBOARD_USER=hermes
HERMES_DASHBOARD_PASSWORD=change-me

# GitHub MCP server token. Requires repo and read:org scopes on the repositories
# you want the agent to inspect. Setting this enables the optional GitHub MCP server
# only after the matching mcp.json entry is explicitly enabled.
GITHUB_MCP_TOKEN=

# Git identity for commits made inside the agent container (e.g. by the kanban-dispatch
# Hermes skill delegating to Codex/Claude Code). No git credential helper is configured
# by default, so this enables `git commit` only — push still requires host-side creds.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# LiteLLM is the default model gateway.
LITELLM_MASTER_KEY=change-me
LITELLM_SALT_KEY=change-me-salt
# Do NOT change LITELLM_SALT_KEY after first run — it encrypts stored virtual keys.

# LiteLLM PostgreSQL database (required for virtual keys and admin UI).
LITELLM_DB_PASSWORD=change-me

# LiteLLM admin UI credentials (http://127.0.0.1:8088/api/litellm/ui).
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# Base URL used by the LiteLLM UI when served through nginx.
# Update if NGINX_BIND, NGINX_PORT, or BASE_PATH differs from defaults.
LITELLM_PROXY_BASE_URL=http://127.0.0.1:8088/api/litellm

# Per-role virtual keys — create with `make litellm-keys` after first boot.
# Falls back to LITELLM_MASTER_KEY if unset (not recommended for production use).
AGENT_VIRTUAL_KEY=
HERMES_VIRTUAL_KEY=
CLAUDE_VIRTUAL_KEY=

# =============================================================================
# Langfuse Observability (observability profile)
# =============================================================================
# After first boot, open http://localhost:3000, create an account, create a
# project, and copy the public/secret keys here. Restart litellm to activate
# tracing (make down && make up-observability).

LANGFUSE_BIND=127.0.0.1
LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse
LANGFUSE_SALT=change-me-langfuse-salt

# Fill in after creating a project in the Langfuse UI:
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# Internal service credentials (safe to leave as defaults for localhost deployments)
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
LANGFUSE_MINIO_USER=langfuse
LANGFUSE_MINIO_PASSWORD=langfuse

# =============================================================================
# BitNet CPU-Only Inference (cpu-llm profile)
# =============================================================================
# Run `make download-bitnet-model` before first boot to fetch the GGUF.
# Then start with: make up-cpu-llm
# Agents can request this model as: bitnet-2b

# Path to the GGUF file inside the container (mounted from ./models/bitnet).
BITNET_MODEL=/models/ggml-model-i2_s.gguf
# Context window size. 2B model supports up to 4096 tokens.
BITNET_CTX_SIZE=4096
# CPU threads for inference. Match to physical cores available.
BITNET_THREADS=4

# Optional host-side setup behavior.
WIREGUARD_SOURCE=/path/to/wireguard.conf
COPY_WIREGUARD_CONFIG=0

# Tool versions used by Dockerfiles.
OPENCODE_VERSION=1.15.12
SOCKET_VERSION=1.1.102
PIP_AUDIT_VERSION=2.10.0
OSV_SCANNER_VERSION=v2.3.8
SCORECARD_VERSION=v5.2.1
TTYD_VERSION=1.7.7
LITELLM_VERSION=1.86.2
OH_MY_ZSH_REF=master
MICROSOCKS_REF=master
# Nix-agent profile versions (only used when building the nix profile).
DEVBOX_VERSION=0.17.2
NIX_VERSION=2.29.1

# Optional agent CLIs. Keep disabled unless you pin the package spec.
INSTALL_CODEX_CLI=0
CODEX_CLI_PACKAGE=@openai/codex@0.140.0
INSTALL_CLAUDE_CODE=0
CLAUDE_CODE_PACKAGE=@anthropic-ai/claude-code@2.1.169
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
INSTALL_HERMES_AGENT=0
# pypi: install pinned version from PyPI (requires HERMES_AGENT_VERSION).
# official: use the official install script from nousresearch.com (ignores HERMES_AGENT_VERSION).
HERMES_INSTALL_METHOD=official
HERMES_AGENT_VERSION=0.16.0
# Remote Ollama model the Hermes LiteLLM alias points at (must support >=64k context).
# Run `make restart-litellm` after changing this value.
HERMES_OLLAMA_MODEL=hermes3:8b
