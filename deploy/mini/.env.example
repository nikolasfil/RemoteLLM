COMPOSE_PROJECT_NAME=remotellm-mini
TZ=Europe/Athens
PUID=1000
PGID=1000

# Nginx bind address. Default is localhost-only (access via SSH tunnel or Tailscale).
# Set to 0.0.0.0 only when protected by Tailscale ACLs.
NGINX_BIND=127.0.0.1
NGINX_PORT=8088
# Base path for nested deployment behind another nginx (e.g. /remotellm). Leave empty for root deployment.
BASE_PATH=

# External Hermes API — the remote OpenAI-compatible endpoint this machine proxies to.
# HERMES_API_URL: base URL of the API (e.g. http://main-machine.tailnet:4000/v1).
# HERMES_API_KEY: API key / LiteLLM master key on the remote side.
# HERMES_LITELLM_MODEL: model identifier as the remote API expects (openai/<name>).
HERMES_API_URL=http://main-machine.tailnet:4000/v1
HERMES_API_KEY=change-me
HERMES_LITELLM_MODEL=openai/hermes

# LiteLLM master key for this machine's proxy.
# Used by the agent container to authenticate to LiteLLM locally.
LITELLM_MASTER_KEY=change-me

# Per-role virtual keys (optional — falls back to LITELLM_MASTER_KEY).
AGENT_VIRTUAL_KEY=

# LiteLLM proxy base URL (for redirect headers in the admin UI).
# Update if NGINX_BIND, NGINX_PORT, or BASE_PATH differs from defaults.
LITELLM_PROXY_BASE_URL=http://127.0.0.1:8088/api/litellm

# LiteLLM image version — must match what was built and transferred.
LITELLM_VERSION=1.86.2
