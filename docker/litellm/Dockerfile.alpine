# syntax=docker/dockerfile:1.7
# Alpine variant — EXPERIMENTAL.
# LiteLLM pulls many binary wheels built for glibc (manylinux). Alpine uses musl,
# so some wheels may fail to install or segfault at runtime.
# If you hit import errors on startup, use Dockerfile.slim (Debian bookworm-slim) instead.
#
# Target: ~60-80 MB compressed (vs ~120 MB for slim), if all wheels resolve.

FROM python:3.12.8-alpine3.21 AS build
ARG LITELLM_VERSION=1.86.2
RUN apk add --no-cache \
        gcc=13.2.1_git20240309-r0 \
        musl-dev=1.2.5-r4 \
        libffi-dev=3.4.6-r0 \
        openssl-dev=3.3.3-r0 \
        cargo=1.78.0-r0
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefix=/opt/litellm --no-compile \
        "litellm[proxy]==${LITELLM_VERSION}" \
        socksio \
        prisma

FROM python:3.12.8-alpine3.21 AS runtime
RUN apk add --no-cache \
        libffi=3.4.6-r0 \
        openssl=3.3.3-r0
ENV PATH="/opt/litellm/bin:${PATH}" \
    PYTHONPATH="/opt/litellm/lib/python3.12/site-packages"
COPY --from=build /opt/litellm /opt/litellm
WORKDIR /app
EXPOSE 4000
